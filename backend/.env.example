# ── Core ───────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Bind loopback locally. Set 0.0.0.0 inside a container/proxy.
HOST=127.0.0.1
APP_URL=http://localhost:3000
LOG_LEVEL=info

# MongoDB is required. `npm run demo` supplies an in-memory database instead.
MONGO_URI=mongodb://127.0.0.1:27017/pawcompanion

# Generate once per environment:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=

# Comma-separated exact origins. Production requires HTTPS.
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
TRUST_PROXY=

# Shared rate limits across instances. Optional for a single-instance demo.
# Production should use a TLS Redis (rediss://).
REDIS_URL=

# ── Sessions & uploads ─────────────────────────────────
SESSION_DAYS=30
ACCESS_TOKEN_MINUTES=15
UPLOAD_DIR=uploads

# ── Payments ───────────────────────────────────────────
# This build ships with an auditable sandbox provider. A production demo must
# opt in explicitly; do not use it with real guests or real money.
PAYMENTS_MODE=sandbox
ALLOW_SANDBOX_PAYMENTS=false

# ── AI companionship (provider-first) ───────────────────
# Fill-in checklist: ../docs/PROVIDER_SETUP.md
# Production chat/mode/onboarding require a configured provider. There is no
# silent keyword fallback in production; local stubs are test-only.
ENABLE_AI=true
LLM_PRIMARY_PROVIDER=openai
LLM_PRIMARY_BASE_URL=
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_MODEL=your-primary-model-id
LLM_PRIMARY_ROUTER_MODEL=your-router-model-id
LLM_FALLBACK_PROVIDER=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_MAX_TOKENS=220
HF_TEMPERATURE=0.7
HF_ROUTER_THRESHOLD=0.55

# Dedicated safety classifier. If empty, the hard crisis kill-switch still runs.
SAFETY_PROVIDER=
SAFETY_BASE_URL=
SAFETY_API_KEY=
SAFETY_MODEL=

# Legacy/optional Hugging Face path for the built-in safety/image adapters.
HUGGINGFACE_API_KEY=
HF_IMAGE_MODEL=stabilityai/stable-diffusion-xl-base-1.0

# ── Demo / container seed ─────────────────────────────
DEMO_MODE=true
# Used by backend/scripts/render-start.sh in the one-service demo image.
SEED_DEMO=false
# Only set this for a disposable demo database.
ALLOW_SEED_IN_PRODUCTION=false
# Production demo seed refuses to start without a private admin password.
DEMO_ADMIN_PASSWORD=
# Optional overrides for the local/demo accounts.
DEMO_CUSTOMER_PASSWORD=
DEMO_MERCHANT_PASSWORD=

# ── Capability provider slots ──────────────────────────
# Fill only the capabilities you want to run. Unfilled slots use the local
# deterministic fallback; production chat/onboarding do not.
CLASSIFIER_PROVIDER=
CLASSIFIER_BASE_URL=
CLASSIFIER_API_KEY=
CLASSIFIER_MODEL=

MODERATION_PROVIDER=
MODERATION_BASE_URL=
MODERATION_API_KEY=
MODERATION_MODEL=

TEXT_EMBEDDING_PROVIDER=
TEXT_EMBEDDING_BASE_URL=
TEXT_EMBEDDING_API_KEY=
TEXT_EMBEDDING_MODEL=

AUDIO_EMBEDDING_PROVIDER=
AUDIO_EMBEDDING_BASE_URL=
AUDIO_EMBEDDING_API_KEY=
AUDIO_EMBEDDING_MODEL=

IMAGE_PROVIDER=
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

STT_PROVIDER=
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=

# 2D avatar asset generation/auto-rig (offline). Runtime animation is local.
AVATAR_GENERATION_PROVIDER=
AVATAR_GENERATION_BASE_URL=
AVATAR_GENERATION_API_KEY=
AVATAR_GENERATION_MODEL=
# rive | live2d | spine | sprite
AVATAR_RUNTIME=

VECTOR_DB_URL=
VECTOR_DB_API_KEY=
VECTOR_DB_COLLECTION=

OBSERVABILITY_PROVIDER=
OBSERVABILITY_API_KEY=
OBSERVABILITY_PROJECT=

# Legacy HF model overrides (used by the built-in adapters when set).
HF_CHAT_MODEL=
HF_ROUTER_MODEL=
