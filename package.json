{
  "name": "pawcompanion",
  "version": "2.0.0",
  "private": true,
  "description": "PawCompanion — an online + in-person pet companionship product",
  "scripts": {
    "install:all": "npm --prefix backend ci && npm --prefix frontend ci",
    "demo": "npm --prefix backend run demo",
    "demo:api": "npm --prefix backend run demo:api",
    "dev": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "seed": "npm --prefix backend run seed",
    "test": "npm --prefix backend test",
    "build": "npm --prefix frontend run build",
    "e2e": "node tools/e2e.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.55.0"
  },
  "engines": {
    "node": ">=24"
  }
}
